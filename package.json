{
  "name": "course-tracking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-server/server/firebase.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "predev": "npm run build:functions",
    "dev": "concurrently -k -n build,emulators,web -c yellow,cyan,magenta \"npm:dev:functions\" \"npm:dev:emulators\" \"npm:dev:client\"",
    "dev:functions": "tsc -p tsconfig.server.json --watch --preserveWatchOutput",
    "dev:emulators": "firebase emulators:start --only functions,firestore --project demo-course-tracking",
    "dev:client": "vite",
    "build": "npm run build:functions && npm run build:client",
    "build:functions": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "deploy": "npm run build && firebase deploy",
    "test:mcp": "npm run build:functions && node --test tests/mcp.integration.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "firebase-tools": "^15.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
